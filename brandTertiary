import React, { useState } from "react";
import { View, Text, StyleSheet, Pressable, TextInput } from "react-native";
import { useTheme } from "../src/theme";

export default function MercadoLivreCard() {
  const { colors } = useTheme();
  const [conectado, setConectado] = useState(false);
  const [clientId, setClientId] = useState("");
  const [clientSecret, setClientSecret] = useState("");

  const handleSalvar = () => {
    if (clientId && clientSecret) {
      setConectado(true);
      // Aqui você dispararia o fetch para a API do seu backend
    }
  };

  return (
    <View style={[styles.card, { backgroundColor: colors.surfaceSecondary, borderColor: colors.border }]}>
      {/* Cabeçalho do Card Tático */}
      <View style={styles.row}>
        <View style={[styles.avatarContainer, { backgroundColor: colors.brandTertiary }]}>
          <Text style={[styles.avatarText, { color: colors.onBrandTertiary }]}>ML</Text>
        </View>
        
        <View style={styles.infoContainer}>
          <Text style={[styles.title, { color: colors.onSurface }]}>Mercado Livre</Text>
          <View style={[styles.badge, { backgroundColor: conectado ? colors.success : colors.surfaceTertiary }]}>
            <Text style={[styles.badgeText, { color: conectado ? colors.onSuccess : colors.muted }]}>
              {conectado ? "CONECTADO" : "DESCONECTADO"}
            </Text>
          </View>
        </View>
      </View>

      {/* Formulário de Configuração Limpo e Denso */}
      <View style={styles.form}>
        <TextInput
          placeholder="Client ID"
          placeholderTextColor={colors.muted}
          value={clientId}
          onChangeText={setClientId}
          style={[styles.input, { backgroundColor: colors.surfaceTertiary, color: colors.onSurface, borderColor: colors.border }]}
        />
        <TextInput
          placeholder="Client Secret"
          placeholderTextColor={colors.muted}
          secureTextEntry
          value={clientSecret}
          onChangeText={setClientSecret}
          style={[styles.input, { backgroundColor: colors.surfaceTertiary, color: colors.onSurface, borderColor: colors.border }]}
        />
        
        <Pressable 
          onPress={handleSalvar}
          style={({ pressed }) => [
            styles.button, 
            { backgroundColor: colors.brandPrimary, opacity: pressed ? 0.8 : 1 }
          ]}
        >
          <Text style={[styles.buttonText, { color: colors.onBrandPrimary }]}>
            SALVAR CONFIGURAÇÕES
          </Text>
        </Pressable>
      </View>
    </View>
  );
}

